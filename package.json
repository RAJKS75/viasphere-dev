    "highlight.js": "11.11.1",
    "lucide-react": "0.576.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.2.2",
    "vite-tsconfig-paths": "6.1.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.19.19",
